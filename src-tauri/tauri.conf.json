{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quire",
  "version": "0.1.0",
  "identifier": "com.quire.desktop",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run desktop:web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Quire",
    "category": "Productivity",
    "shortDescription": "A local-first journal and drawing page",
    "longDescription": "Quire is a journal and drawing page. Write in Markdown, sketch with paint-style tools, and keep everything on this computer. Entries are stored locally and can be locked with a passcode.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
